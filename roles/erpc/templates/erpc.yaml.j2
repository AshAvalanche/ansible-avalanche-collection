logLevel: {{ erpc_log_level }}

server:
  listenV4: true
  httpHostV4: "{{ erpc_listen_address }}"
  httpPort: 4000
{% if erpc_aliasing_enabled %}
  aliasing:
    rules:
      - matchDomain: "*"
        serveProject: "{{ erpc_project_id }}"
        serveArchitecture: "evm"
{% endif %}
{% if erpc_metrics_enabled %}

metrics:
  enabled: true
  hostV4: "0.0.0.0"
  port: 4001
{% endif %}

projects:
  - id: {{ erpc_project_id }}
    upstreamDefaults:
      rateLimitBudget: default
      failsafe:
        timeout:
          duration: 15s
        retry:
          maxAttempts: 3
          delay: 300ms
          backoffMaxDelay: 5s
          backoffFactor: 1.5
    upstreams:
{% for node in erpc_upstreams %}
{% for chain in erpc_chains %}
      - endpoint: "{{ node }}/ext/bc/{{ chain }}/rpc"
{% endfor %}
{% endfor %}

rateLimiters:
  budgets:
    - id: default
      rules:
        - method: "*"
          maxCount: {{ erpc_default_budget_max_count }}
          period: {{ erpc_default_budget_period }}
